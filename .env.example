# ---------------------------------------------------------------------------
# PAWORA - example environment file
# ---------------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and adjust for your machine.
# The app reads these values through getenv(), so you can either export them in
# your shell / service unit, or load them before starting PHP.
#
# The defaults in config/database.php match a stock LAMPP / XAMPP install, so
# this file is optional for a local LAMP setup.

# --- database -----------------------------------------------------------
# These are the LAMPP defaults. Change them if your install differs.
PAWORA_DB_HOST=127.0.0.1
PAWORA_DB_PORT=3306
PAWORA_DB_NAME=pawora_db
PAWORA_DB_USER=root
PAWORA_DB_PASS=

# --- application --------------------------------------------------------
# Sub-folder the app is served from, with no trailing slash.
#   '/'       -> app is the site root        (php -S ... -t .)
#   '/pawora' -> app is in a sub-directory   (LAMPP htdocs/pawora)
PAWORA_BASE_URL=/pawora
